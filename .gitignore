# ─────────────────────────── Python ───────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ─────────────────────── Virtual environments ─────────────────
.venv/
venv/
env/
ENV/

# ────────────────────────── OS / editor ───────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ────────────────────────── Streamlit ─────────────────────────
.streamlit/secrets.toml

# ─────────────── Caches (regenerated automatically) ───────────
# 19fj/19fk: both caches renamed to say whose inputs they hold.
# Old names kept so a working copy that still has them stays ignored.
.cache/
data/cache/
data/build_baseline_cached_input_data/
data/routing_engine_cached_input_data/

# ────────── Generated pipeline outputs (large; regenerated) ────
data/outputs/
data/exported_rules/

# ─── Split-rule INPUTS — MUST stay in the repo ───────────────────────────────
# The forecast reads its routing rules from data/rules/<MONTH>/<COMPANY>/*.xlsx.
# These are NOT generated outputs — without them every VI-Txn is 0 — so keep them
# tracked. (data/rules/ isn't matched by any ignore above; these explicit un-ignores
# just guard against a future broad pattern accidentally excluding the rule files.)
!data/rules/
!data/rules/**/
!data/rules/**/*.xlsx

# ─── Bundled Google Cloud SDK / installer (not project source) ─
google-cloud-sdk/
google-cloud-cli-*.tar.gz
*.tar.gz

# ─────────── Secrets / credentials (NEVER commit these) ────────
*.pem
*.key
service-account*.json
service_account*.json
gcp-*.json
*-credentials.json
credentials*.json
.env
.env.*

# ─────────────────────────── Logs ─────────────────────────────
*.log

# Numba persistent compile cache (survives __pycache__ clears)
_numba_cache/
**/_numba_cache/
